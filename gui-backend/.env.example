GUI_DB_USER=gui_app
GUI_DB_PASSWORD=
GUI_SECURE_COOKIE=true
# Solo primera puesta en marcha; retirar después de crear el administrador.
GUI_BOOTSTRAP_USERNAME=
GUI_BOOTSTRAP_PASSWORD=
